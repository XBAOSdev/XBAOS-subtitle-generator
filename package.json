{
  "name": "xbaos-subtitle-generator",
  "version": "1.1.0-beta",
  "private": true,
  "description": "把音频转成字幕的 Windows 桌面工具，支持 Whisper 与 SenseVoice 等多种识别模型",
  "author": "XBAOS",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:stop": "node tools/dev-stop.mjs",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "preview:ui": "vite preview",
    "unit": "node tools/run-unit.mjs",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit",
    "probe": "node tools/ui-probe.mjs",
    "probe:electron": "node tools/electron-probe.mjs",
    "probe:site": "node tools/site-probe.mjs",
    "verify": "npm run typecheck && npm run build:ui && node tools/ui-probe.mjs",
    "verify:app": "npm run typecheck && npm run build:ui && node tools/electron-probe.mjs",
    "engine": "bash engine/build.sh",
    "engine:onnx": "bash engine-onnx/build.sh",
    "dist:dir": "npm run build:ui && electron-builder --win --dir",
    "dist": "npm run build:ui && electron-builder --win"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  }
}
